{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "bens-wacky-popularity",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGIN": "https://civil-civix.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bens-wacky-popularity",
      "database_id": "bedb0332-b11b-40bc-af12-69529685d87c"
    }
  ],
  "ratelimits": [
    {
      "name": "IP_LIMIT",
      "namespace_id": "2026091901",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "VISITOR_LIMIT",
      "namespace_id": "2026091902",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "17 0 * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
