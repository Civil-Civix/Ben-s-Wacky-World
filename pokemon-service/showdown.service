[Unit]
Description=Ben's Wacky World Pokemon Showdown
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=showdown
Group=showdown
WorkingDirectory=/opt/showdown/pokemon-showdown
ExecStart=/usr/local/bin/node pokemon-showdown start --skip-build 8000
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
UMask=0027

[Install]
WantedBy=multi-user.target
