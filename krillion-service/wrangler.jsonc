{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bens-wacky-krillion",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bens-wacky-krillion",
      "database_id": "3e61ef1c-c0e2-47f4-88d4-73b8318b13ee",
      "migrations_dir": "migrations"
    },
    {
      "binding": "ACCOUNTS_DB",
      "database_name": "bens-wacky-accounts",
      "database_id": "5e683b3e-fcda-4a84-8d55-0db23514438e"
    }
  ],
  "vars": {
    "SITE_URL": "https://bens-wacky-krillion.mr-ellis1009.workers.dev",
    "REFERENCE_SYNC": "true",
    "LOCAL_DEVELOPMENT": "false"
  },
  "observability": {
    "enabled": true
  }
}
