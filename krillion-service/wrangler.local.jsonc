{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bens-wacky-krillion",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bens-wacky-krillion",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SITE_URL": "https://bens-wacky-krillion.mr-ellis1009.workers.dev",
    "REFERENCE_SYNC": "false",
    "LOCAL_DEVELOPMENT": "true"
  },
  "observability": {
    "enabled": true
  }
}
